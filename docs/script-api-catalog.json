    {
      "name": "remote.close",
      "category": "lifecycle",
      "parameters": [],
      "returns": "None"
    },
    {
      "name": "ScriptPaths.close",
      "category": "lifecycle",
      "parameters": [],
      "returns": "None"
    }
  ],
  "models": {
    "ScriptPaths": {
      "run_id": "str",
      "run_dir": "Path",
      "runtime_path": "Path",
      "log_path": "Path",
      "output_path": "Path",
      "params_path": "Path",
      "result_path": "Path",
      "arguments": "readonly Mapping[str, JSONValue]"
    },
    "FileHandle": {
      "path": "Path",
      "filename": "str",
      "size": "int",
      "sha256": "str"
    },
    "RemoteCheckResult": {
      "success": "bool",
      "status": "available | unavailable",
      "transport_ready": "bool",
      "error_type": "str | None",
      "error_message": "str | None",
      "check_scope": "command | keyword | prompt | None",
      "exit_status_available": "bool | None"
    },
    "CommandResult": {
      "status": "CommandStatus",
      "exit_code": "int | None",
      "stdout": "str",
      "stderr": "str",
      "output": "str",
      "raw_output": "str",
      "phase": "CommandPhase",
      "success": "bool",
      "with_failure": "(message, error_type=BUSINESS_RULE_FAILED) -> CommandResult"
    }
  },
  "capabilities": {
    "ssh": [
      "self_check",
      "upload",
      "download",
      "run",
      "execute",
      "retry",
      "close"
    ],
    "telnet": [
      "self_check",
      "run",
      "execute",
      "read",
      "wait_reboot",
      "telnet_wait_exec",
      "mark_output",
      "retry",
      "close"
    ],
    "ftp": [
      "self_check",
      "upload",
      "download",
      "retry",
      "close"
    ]
  },
  "configuration": {
    "directory": "environments/topologies/<topology>/connections.json",
    "format": "array of flat connection objects",
    "telnet_self_check": {
      "recommended_shell_mode": "auto",
      "posix": "unique probe output and exit status 0; check_scope=command, exit_status_available=true",
      "prompt_only_with_probe": "paired probe_command/probe_keyword, excluding command echo; check_scope=keyword, exit_status_available=false",
      "prompt_only_without_probe": "connected transport and recognized prompt only; check_scope=prompt, exit_status_available=false",
      "partial_probe_configuration": "fails self-check",
      "credentials": "send only when the configured login prompt is active; preserve an already logged-in shell, ignoring Last login banners",
      "unknown_command_result": "prompt readiness does not create exit status; execute remains RESULT_UNKNOWN with exit_code=None",
      "other_protocols": "check_scope and exit_status_available default to None"
    },
    "ssh_upload_type": [
      "scp",
      "sftp"
    ],
    "argument_types": [
      "str",
      "int",
      "float",
      "bool",
      "list",
      "dict"
    ]
  },
  "cli": {
    "entry": "python -X utf8 -m autoenv.cli",
    "metadata": [
      "list --json",
      "describe SCRIPT --json"
    ],
    "execute": "run SCRIPT --non-interactive --topology NAME --bind role=connection --arg name=value --package config=hdfs_path",
    "stdout": "one existing absolute run.log path",
    "exit_codes": {
      "0": "success",
      "1": "execution failure",
      "2": "preparation failure"
    }
  },
  "logging": {
    "run_log": "full source trace, results, remote output, print/stderr",
    "output_log": "concise per-operation results for live Web output"
  },
  "verification": "docs/LOCAL_SIMULATION.md"
}
