    },
    {
      "name": "TelnetRemote.execute",
      "category": "environment",
      "parameters": [
        "command: str",
        "timeout: float | None = None",
        "expect_disconnect: bool = False"
      ],
      "returns": "CommandResult"
    },
    {
      "name": "TelnetRemote.read",
      "category": "environment",
      "parameters": [],
