{
  "schema_version": 2,
  "updated": "2026-10-11",
  "script_entry": "ordinary scripts/<name>.py main() or module scope; no register_script",
  "categories": [
    "environment",
    "local_file",
    "hdfs",
    "generation"
  ],
  "operations": [
    {
      "name": "init_script",
      "category": "initialization",
      "parameters": [],
      "returns": "ScriptPaths"
    },
    {
      "name": "get_remote_info",
      "category": "environment",
      "parameters": [
        "required_type: Literal[ssh,telnet,ftp]",
        "allowed_envs: Sequence[tuple[str,str]]"
      ],
      "returns": "SSHRemote | TelnetRemote | FTPRemote"
    },
    {
      "name": "get_file",
      "category": "local_file",
      "parameters": [
        "path: PathLike",
        "filename: str"
      ],
      "returns": "FileHandle"
    },
    {
      "name": "fuzz_search",
      "category": "local_file",
      "parameters": ["path: PathLike", "pattern: str = ''", "recursive: bool = false"],
      "returns": "FileHandleGroup (filename, relative_path ascending; lazy cached handles)"
    },
    {
      "name": "accurate_search",
      "category": "local_file",
      "parameters": ["path: PathLike", "pattern: str = ''", "recursive: bool = false"],
      "returns": "FileHandle | None (first exact basename or glob match)"
    },
    {
      "name": "get_handler",
      "category": "local_file",
      "parameters": ["path: PathLike", "recursive: bool = false"],
      "returns": "FileHandleGroup"
    },
    {
      "name": "find_subdir",
      "category": "local_file",
      "parameters": ["path: PathLike", "partial_path: str", "recursive: bool = true"],
      "returns": "Path (unique contiguous partial directory path match)"
    },
    {
      "name": "FileHandle.unzip",
      "category": "local_file",
      "parameters": ["unzip_path: PathLike", "max_files: int = 10000 (keyword)", "max_bytes: int = 5368709120 (keyword)"],
      "returns": "Path (safe single-layer content-detected ZIP/TAR/GZ/RAR extraction; RAR requires local bsdtar)"
    },
    {
      "name": "detect_archive",
      "category": "local_file",
      "parameters": ["path: PathLike"],
      "returns": "Literal[zip,tar,gz,rar] | None (TAR includes compressed variants)"
    },
    {
      "name": "FileHandle.move_to",
      "category": "local_file",
      "parameters": ["destination_dir: PathLike"],
      "returns": "FileHandle (copy, source preserved; no overwrite)"
    },
    {
      "name": "FileHandle.rename",
      "category": "local_file",
      "parameters": ["new_name: str (basename)"],
      "returns": "FileHandle (real rename, immutable replacement)"
    },
    {
      "name": "hdfs_download",
      "category": "hdfs",
      "parameters": [
        "path: PathLike",
        "config_json_name: str"
      ],
      "returns": "FileHandle"
    },
    {
      "name": "create_file",
      "category": "generation",
      "parameters": [
        "path: PathLike",
        "filename: str",
        "content: str | bytes"
      ],
      "returns": "FileHandle"
    },
    {
      "name": "SSHRemote.upload",
      "category": "environment",
      "parameters": [
        "file: FileHandle",
        "path: str"
      ],
      "returns": "None"
    },
    {
      "name": "SSHRemote.download",
      "category": "environment",
      "parameters": [
        "path: str",
        "filename: str"
      ],
      "returns": "FileHandle"
    },
    {
      "name": "FTPRemote.upload",
      "category": "environment",
      "parameters": [
        "file: FileHandle",
        "path: str"
      ],
      "returns": "None"
    },
    {
      "name": "FTPRemote.download",
      "category": "environment",
      "parameters": [
        "path: str",
        "filename: str"
      ],
      "returns": "FileHandle"
    },
    {
      "name": "SSHRemote.run",
      "category": "environment",
      "parameters": [
        "command: str"
      ],
      "returns": "str"
    },
    {
      "name": "TelnetRemote.run",
      "category": "environment",
      "parameters": [
        "command: str"
      ],
      "returns": "str"
    },
    {
      "name": "SSHRemote.execute",
      "category": "environment",
      "parameters": [
        "command: str",
